{
  "include": ["src/index.ts","src/typings/*.ts"],
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "incremental": true,
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "sourceMap": true,
    "strict": true,
    "target": "ES2021",
    "skipLibCheck": true,
    "types": []
  }
}
