{
  "name": "fiveringsdb-node",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "yarn build:clean && yarn build:server && yarn build:client",
    "build:clean": "rimraf dist",
    "build:client": "cd client && yarn install && yarn build && cd .. && cp -r client/build dist/public",
    "build:server": "tsc",
    "build:test": "rimraf .ava-build && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:latest": "knex migrate:latest",
    "migrate:make": "knex migrate:make",
    "start:all:dev": "concurrently \"yarn start:server:dev\" \"node bin/wait-for-port.mjs 8080 && cd client && yarn start\"",
    "start:server:dev": "cross-env NODE_ENV=development sh bin/watch.sh",
    "start": "NODE_ENV=production yarn migrate:latest && node dist/index.js",
    "test": "yarn lint && yarn test:unit && yarn build && ava",
    "test:unit": "yarn build:clean && yarn build:test && ava",
    "test:unit:watch": "yarn build:test && concurrently --raw \"tsc -p tsconfig.test.json --watch --preserveWatchOutput\" \"ava --watch\"",
    "import:prod": "tsc && node dist/scripts/importFromProd.js",
    "heroku-prebuild": "cd client && yarn heroku-prebuild && cd .."
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "volta": {
    "node": "26.13.1",
    "yarn": "4.18.1"
  },
  "packageManager": "yarn@4.18.1",
  "license": "MIT",
  "dependencies": {
    "@5rdb/api": "link:./apiTypings",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.27",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "compression": "1.8.2",
    "concurrently": "10.0.7",
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "discord.js": "14.28.1",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-security": "4.2.1",
    "express": "5.3.0",
    "express-jwt": "8.5.1",
    "fuse.js": "7.5.0",
    "helmet": "8.3.0",
    "joi": "18.3.2",
    "jwks-rsa": "4.1.0",
    "knex": "3.3.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "source-map-support": "0.5.21",
    "typescript": "7.0.2",
    "uuid": "14.0.3"
  },
  "ava": {
    "files": [
      "src/**/*.test.ts",
      "client/src/**/*.test.ts"
    ],
    "typescript": {
      "rewritePaths": {
        "src/": ".ava-build/src/",
        "client/src/": ".ava-build/client/src/"
      },
      "compile": false
    }
  },
  "devDependencies": {
    "@ava/typescript": "7.0.0",
    "@types/compression": "1.8.1",
    "ava": "8.4.0",
    "nodemon": "3.1.14",
    "rimraf": "6.1.4"
  }
}
